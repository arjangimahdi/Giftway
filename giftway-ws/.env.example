# Copy to .env and adjust for your machine: cp .env.example .env

NODE_ENV=development

# API
PORT=3333
CLIENT_URL=http://localhost:4200

# MongoDB
# Host (running the API outside Docker): mongodb://localhost:27017/giftway
# Compose (API in Docker): the host is the `mongo` service name
MONGODB_URI=mongodb://mongo:27017/giftway
MONGO_PORT=27017

# Web (Next inlines NEXT_PUBLIC_* at build time)
NEXT_PUBLIC_API_URL=http://localhost:3333
NEXT_PUBLIC_SITE_URL=http://localhost:4200
